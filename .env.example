# HealthSync — 12-Factor Ortam Değişkenleri Şablonu
APP_VERSION=1.0.0
GIT_COMMIT=HEAD
LOG_LEVEL=INFO
TZ=Europe/Istanbul

# Veritabanı ve Önbellek / Olay Veri Yolu
POSTGRES_USER=healthsync
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=healthsync_db
DATABASE_URL=postgresql://healthsync:change_me_in_production@db:5432/healthsync_db
REDIS_URL=redis://redis:6379/0

# Mikroservis Dahili Uç Noktaları
RENPHO_SERVICE_URL=http://renpho-sync:8001
GARMIN_SERVICE_URL=http://garmin-sync:8002
WATCH6_SERVICE_URL=http://watch6-ingest:8003
RECONCILIATION_SERVICE_URL=http://reconciliation:8004
ANALYTICS_SERVICE_URL=http://analytics-anomaly:8005
AI_SERVICE_URL=http://ai-advisor:8006
SCHEDULER_SERVICE_URL=http://scheduler:8007

# Devre Kesici (Circuit Breaker) ve Zaman Aşımı Ayarları
SERVICE_TIMEOUT_SECONDS=5.0
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=30

# Renpho ES-26BB-B Bulut Kimlik Bilgileri
RENPHO_EMAIL=
RENPHO_PASSWORD=

# Garmin Smart Band (Garmin Connect) Kimlik Bilgileri
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_DIR=/data/garmin_tokens

# Samsung Galaxy Watch6 / Health Connect Webhook ve Otomatik Klasör İzleyici
WEBHOOK_SECRET_TOKEN=
WATCH_EXPORT_DIR=/data/watch_exports

# Gemini AI Danışman
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Otomatik Senkronizasyon Periyodu (Dakika)
AUTO_SYNC_INTERVAL_MINUTES=60
